{
  "name": "mcp-mercado-livre",
  "version": "0.1.0-paulo",
  "description": "Fork de @dan1d/mercadolibre-mcp com OAuth offline (authorization_code + refresh_token), default MLB, filtros extras de search e curadoria de attributes. Auditado pra uso em Hermes Agent (Paulo Nonaka).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "bin",
    "README.md",
    "AUDIT.md",
    "LICENSE"
  ],
  "bin": {
    "mcp-mercado-livre": "./bin/mcp-server.mjs",
    "mcp-mercado-livre-oauth-bootstrap": "./bin/oauth-bootstrap.mjs"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "oauth:bootstrap": "node bin/oauth-bootstrap.mjs"
  },
  "author": "Paulo Nonaka (fork de dan1d)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "local"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "1.6.1",
    "typescript": "5.4.5",
    "vitest": "1.6.1"
  }
}
